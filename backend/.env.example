# RawSyst POS — backend environment
#
# Copy to .env for local development. .env is gitignored and must never be
# committed.
#
# NOTE: no legal value belongs in this file. VAT rates, GOSI rates, filing
# thresholds and wage-file formats all live in the Regulatory Rule Registry as
# effective-dated data, so a change is a configuration update rather than a
# release. See docs/system-design/05-regulatory-rule-registry.md.

RAWSYST_ENV=development
RAWSYST_SERVICE_NAME=rawsyst-api

# Which region THIS stack serves. Blueprint E4.2 requires per-tenant data
# residency; v1 deploys the Saudi region only.
RAWSYST_DATA_REGION=sa

RAWSYST_HTTP_ADDR=:8080

# PostgreSQL. Use a dedicated application role, never a superuser: superusers
# bypass row-level security, which would silently disable tenant isolation.
RAWSYST_DB_DSN=postgres://rawsyst:CHANGE_ME@localhost:5432/rawsyst_dev?sslmode=disable
RAWSYST_DB_MAX_CONNS=20
RAWSYST_DB_MIN_CONNS=2

# Token signing. At least 32 bytes; generate with:
#   openssl rand -base64 48
# In production this must come from a secret manager, not a file.
RAWSYST_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_BYTES
RAWSYST_JWT_ISSUER=rawsyst-pos
RAWSYST_ACCESS_TOKEN_TTL=15m
RAWSYST_REFRESH_TOKEN_TTL=720h

# The ZATCA CSID signing key is deliberately absent. It is generated on the POS
# terminal, stored in that machine's OS keystore, and never transmitted to the
# server. See docs/system-design/01-invoice-zatca-engine.md section 7.

# Browser origins allowed to call this API.
#
# Empty means none, which is right for a deployment that only serves the Tauri
# POS: a desktop shell issues requests outside a browser origin and is not
# subject to the same-origin policy. The moment a web back office exists it
# must be listed here, exactly, or every call it makes fails at the preflight —
# and it fails invisibly, because no build or unit test can detect it.
#
# An allow-list, never a wildcard. This API is credentialed, and a wildcard
# would let any page a signed-in owner happened to visit read their books.
#
# The DESKTOP TILL is not listed here and does not need to be. Its origin is
# fixed by Tauri rather than chosen by a deployment, so the API allows it
# unconditionally — see tauriOrigins in cmd/api/main.go. Leaving it to this
# variable is how a shop ends up with a till that cannot sign in and a screen
# that says nothing more useful than "Sign-in did not complete."
RAWSYST_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
