# RawSyst POS — backend environment
#
# Copy to .env for local development. .env is gitignored and must never be
# committed.
#
# NOTE: no legal value belongs in this file. VAT rates, GOSI rates, filing
# thresholds and wage-file formats all live in the Regulatory Rule Registry as
# effective-dated data, so a change is a configuration update rather than a
# release. See docs/system-design/05-regulatory-rule-registry.md.

RAWSYST_ENV=development
RAWSYST_SERVICE_NAME=rawsyst-api

# Which region THIS stack serves. Blueprint E4.2 requires per-tenant data
# residency; v1 deploys the Saudi region only.
RAWSYST_DATA_REGION=sa

RAWSYST_HTTP_ADDR=:8080

# PostgreSQL. Use a dedicated application role, never a superuser: superusers
# bypass row-level security, which would silently disable tenant isolation.
RAWSYST_DB_DSN=postgres://rawsyst:CHANGE_ME@localhost:5432/rawsyst_dev?sslmode=disable
RAWSYST_DB_MAX_CONNS=20
RAWSYST_DB_MIN_CONNS=2

# Token signing. At least 32 bytes; generate with:
#   openssl rand -base64 48
# In production this must come from a secret manager, not a file.
RAWSYST_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_BYTES
RAWSYST_JWT_ISSUER=rawsyst-pos
RAWSYST_ACCESS_TOKEN_TTL=15m
RAWSYST_REFRESH_TOKEN_TTL=720h

# The ZATCA CSID signing key is deliberately absent. It is generated on the POS
# terminal, stored in that machine's OS keystore, and never transmitted to the
# server. See docs/system-design/01-invoice-zatca-engine.md section 7.

# Browser origins allowed to call this API.
#
# Empty means none, which is right for a deployment that only serves the Tauri
# POS: a desktop shell issues requests outside a browser origin and is not
# subject to the same-origin policy. The moment a web back office exists it
# must be listed here, exactly, or every call it makes fails at the preflight —
# and it fails invisibly, because no build or unit test can detect it.
#
# An allow-list, never a wildcard. This API is credentialed, and a wildcard
# would let any page a signed-in owner happened to visit read their books.
#
# The DESKTOP TILL is not listed here and does not need to be. Its origin is
# fixed by Tauri rather than chosen by a deployment, so the API allows it
# unconditionally — see tauriOrigins in cmd/api/main.go. Leaving it to this
# variable is how a shop ends up with a till that cannot sign in and a screen
# that says nothing more useful than "Sign-in did not complete."
RAWSYST_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- optional infrastructure ------------------------------------------------
#
# Every one of these is genuinely optional, and the product says at start-up
# which of them it is running without. A shop with one server and one API
# process needs none of them.

# Redis. Empty means an in-memory cache, which is CORRECT for one API process
# and only for one.
#
# The moment there are two — a second replica, or a rolling deploy with both
# versions briefly up — an in-memory cache stops being correct: a permission
# revoked on one replica stays live on the other, and a rate limit of ten
# becomes a limit of twenty. Bring up the `scale` profile and set these.
#   RAWSYST_REDIS_ADDR=redis:6379
RAWSYST_REDIS_ADDR=
RAWSYST_REDIS_PASSWORD=
RAWSYST_REDIS_DB=0
RAWSYST_REDIS_TLS=false

# S3-compatible object storage. Empty means documents, logos and generated
# reports stay in Postgres, which is correct and does not scale — a million
# receipt PDFs in a table is a backup nobody can restore in an afternoon.
#
# Any S3-compatible endpoint: MinIO on the shop's own server, Amazon,
# Cloudflare R2, Wasabi, DigitalOcean Spaces. The endpoint is configuration on
# purpose — a PDPL deployment may be required to keep records inside the
# Kingdom, and that is not a decision this product should be making.
#
# Must be https outside development: config refuses to start otherwise.
#   RAWSYST_S3_ENDPOINT=http://minio:9000
RAWSYST_S3_ENDPOINT=
RAWSYST_S3_BUCKET=
RAWSYST_S3_REGION=us-east-1
RAWSYST_S3_ACCESS_KEY_ID=
RAWSYST_S3_SECRET_ACCESS_KEY=
# Bucket in the path rather than the hostname. On by default because it works
# everywhere, and the deployments that need it — MinIO, anything on an IP
# address — fail with a DNS error nobody reads as a bucket problem.
RAWSYST_S3_PATH_STYLE=true

# The Prometheus scrape endpoint at /metrics.
#
# The TOKEN IS REQUIRED outside development when metrics are on, and config
# refuses to start without it: the endpoint describes how much business every
# shop on this stack is doing. Nginx also answers /metrics with 404 from
# outside, so a scraper reaches it over the internal network only.
#   openssl rand -hex 32
RAWSYST_METRICS_ENABLED=true
RAWSYST_METRICS_TOKEN=CHANGE_ME

# Error reporting. Empty means off, which is the default — most shops run one
# server and read the logs.
#
# What is sent is bounded on this side rather than in Sentry's settings: a 5xx
# or a panic, with the request id, the route PATTERN, the method, the status
# and the tenant uuid. No query string, no headers, no body, no email, no IP.
RAWSYST_SENTRY_DSN=
# The fraction of performance TRACES sampled, 0 to 1. Errors are always sent.
RAWSYST_SENTRY_SAMPLE_RATE=0.1
