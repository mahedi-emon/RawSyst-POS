# RawSyst POS — deployment environment.
#
#   cp .env.example .env   and fill in every value marked CHANGE_ME.
#
# .env is gitignored and is in .dockerignore: a credential copied into an image
# is readable by anyone who can pull it, and `docker history` shows it even
# after a later layer deletes the file.

# --- the database -----------------------------------------------------------
POSTGRES_DB=rawsyst
POSTGRES_USER=rawsyst
# openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# --- the application --------------------------------------------------------
RAWSYST_ENV=production

# Which region THIS stack serves. Blueprint E4.2 requires per-tenant data
# residency; a deployment serves one.
RAWSYST_DATA_REGION=sa

# Token signing. At least 32 bytes.
#   openssl rand -base64 48
RAWSYST_JWT_SECRET=CHANGE_ME
RAWSYST_JWT_ISSUER=rawsyst-pos

# Envelope encryption for credentials at rest, newest key first.
#
# The version is written explicitly rather than implied by position, and that
# matters: an implicit scheme where the current key is always v1 survives
# exactly one rotation, and on the second a fresh "v1" collides with the
# original — unreadable credentials with no way back.
#
#   printf '1:%s' "$(openssl rand -base64 32)"
RAWSYST_DATA_ENCRYPTION_KEYS=CHANGE_ME

# Browser origins allowed to call the API. Empty means none, which is correct
# for a deployment serving only the Tauri till. The back office needs its own
# origin listed here.
#   RAWSYST_CORS_ORIGINS=https://office.example.com
RAWSYST_CORS_ORIGINS=

# The shop's local day. The accounting date and every Z report follow it, so
# this is a business setting rather than a preference.
TZ=Asia/Riyadh

# --- where things listen ----------------------------------------------------
API_PORT=8080
WEB_PORT=3000

# --- connection pool --------------------------------------------------------
# Sized against the database's own max_connections, not against traffic. Every
# API replica takes this many.
RAWSYST_DB_MAX_CONNS=20
RAWSYST_DB_MIN_CONNS=2

# Stamped into the image tag and reported by the binaries.
VERSION=dev

# --- optional infrastructure ------------------------------------------------
#
# Every one of these is genuinely optional, and the product says at start-up
# which of them it is running without. A shop with one server and one API
# process needs none of them.

# Redis. Empty means an in-memory cache, which is CORRECT for one API process
# and only for one.
#
# The moment there are two — a second replica, or a rolling deploy with both
# versions briefly up — an in-memory cache stops being correct: a permission
# revoked on one replica stays live on the other, and a rate limit of ten
# becomes a limit of twenty. Bring up the `scale` profile and set these.
#   RAWSYST_REDIS_ADDR=redis:6379
RAWSYST_REDIS_ADDR=
RAWSYST_REDIS_PASSWORD=
RAWSYST_REDIS_DB=0
RAWSYST_REDIS_TLS=false

# S3-compatible object storage.
#
# WHAT ACTUALLY USES THIS TODAY: backups, and nothing else.
#
# Documents, company logos and regulatory source documents are `bytea` columns
# in Postgres — `document.bytes`, `company_logo.bytes`,
# `regulatory_source_document.content` — and they stay there whatever is set
# here. `docker-compose.files.yml` starts a MinIO container; it does not move a
# single document into it, because nothing in the API writes one there. The
# services that store files write SQL.
#
# That is worth stating plainly because the opposite belief is dangerous in one
# specific way: an operator who thinks documents live in the bucket may also
# think the bucket needs its own backup, or that losing the database loses only
# rows. Neither is true. The database dump is the whole of the business data,
# which is exactly what makes `backup verify` a complete check.
#
# Moving files out of Postgres is a real future change and it has a real
# consequence: on the day it happens, the object store stops being somewhere
# backups are kept and starts being something that needs backing up too, and
# `deploy/server/BACKUP.md` says so.
#
# Any S3-compatible endpoint: MinIO on the shop's own server, Amazon,
# Cloudflare R2, Wasabi, DigitalOcean Spaces. The endpoint is configuration on
# purpose — a PDPL deployment may be required to keep records inside the
# Kingdom, and that is not a decision this product should be making.
#
# Must be https outside development: config refuses to start otherwise.
#   RAWSYST_S3_ENDPOINT=http://minio:9000
RAWSYST_S3_ENDPOINT=
RAWSYST_S3_BUCKET=
RAWSYST_S3_REGION=us-east-1
RAWSYST_S3_ACCESS_KEY_ID=
RAWSYST_S3_SECRET_ACCESS_KEY=
# Bucket in the path rather than the hostname. On by default because it works
# everywhere, and the deployments that need it — MinIO, anything on an IP
# address — fail with a DNS error nobody reads as a bucket problem.
RAWSYST_S3_PATH_STYLE=true

# --- backups ----------------------------------------------------------------
#
# Read deploy/server/BACKUP.md before changing any of these. The short version
# is that the settings below decide whether this server can be recovered, and
# the defaults are deliberately not "it works": a backup that quietly writes to
# the disk it is protecting, or that cannot read past row-level security, is
# worse than no backup because it looks like one.

# The role that TAKES the backup, and it must NOT be the application's.
#
# Row-level security is FORCED on ~177 tables, which applies to the table owner
# too. `pg_dump` turns row security off to dump every row and Postgres refuses
# that to any role without BYPASSRLS — so the application role cannot dump its
# own database, and must never be given the attribute that would let it, because
# that attribute is the only thing keeping one business out of another's books.
#
# Create the role with the product rather than by hand:
#
#   RAWSYST_BACKUP_ROLE_PASSWORD=$(openssl rand -base64 24) \
#     docker compose ... run --rm backup role
#
# It is idempotent, it refuses to touch the application's role, and it ends by
# connecting as the new role and proving it can read every table and sequence.
# Then put the SAME password in the connection string below.
#
# Empty falls back to the application's DSN, which on a correctly configured
# server cannot dump — and says so before it starts rather than failing partway.
RAWSYST_BACKUP_DSN=
RAWSYST_BACKUP_ROLE=rawsyst_backup
# Used only when creating the role or when deliberately rotating it. Not read
# by the API, the worker or the till.
RAWSYST_BACKUP_ROLE_PASSWORD=

# A connection to a DIFFERENT database on the same server, as a role that may
# CREATE DATABASE and CREATE ROLE. Two things need it: the scratch database a
# verification restores into, and `backup role` above. Postgres cannot create a
# database from inside the one being created beside.
RAWSYST_BACKUP_ADMIN_DSN=

# AES-256-GCM over the dump, in 4 MiB chunks, with the chunk number and a
# per-stream prefix authenticated so chunks cannot be reordered, moved between
# two backups sealed with the same key, or truncated.
#
# TURN THIS ON FOR PRODUCTION. It is empty here because a default key would be
# no key at all, and because turning it on commits somebody to never losing a
# value: without it the backup cannot be read by anybody, including this
# product. Generate and store it BEFORE the first backup:
#
#   openssl rand -base64 32
#
# The key belongs in a password manager or a secret store, NOT on this server
# only, and NOT in the bucket — a key kept beside the thing it encrypts is
# decoration. It is never written into a dump, a manifest or a log: the
# manifest carries a 16-character fingerprint so a wrong key says which key it
# wants instead of "decryption failed". deploy/server/SECRETS.md is the
# checklist.
RAWSYST_BACKUP_ENCRYPTION_KEY=

# Where snapshots live inside the bucket, and how many are kept.
RAWSYST_BACKUP_PREFIX=rawsyst
RAWSYST_BACKUP_KEEP_DAILY=7
RAWSYST_BACKUP_KEEP_WEEKLY=4
RAWSYST_BACKUP_KEEP_MONTHLY=3

# How much free space a dump is asked to have where it is staged, as a
# percentage of the database's on-disk size. 100 is deliberately pessimistic: a
# custom-format dump is compressed and carries no indexes, so it is reliably
# smaller. The point is the failure being prevented — on this server the
# staging volume is usually the database's volume, and a dump that fills it
# stops Postgres writing, which is an outage rather than a failed backup.
RAWSYST_BACKUP_MIN_FREE_PERCENT=100

# The most destructive thing this product can do: replace the live database
# with a snapshot. Off unless a deployment says otherwise HERE, where nobody
# with a browser can change it. Even then the API demands a fresh verified
# backup of what is live, a rehearsal that passed, and the snapshot id typed
# out. Read deploy/server/RECOVERY.md before setting it to true.
RAWSYST_ALLOW_PRODUCTION_RESTORE=false

# The Prometheus scrape endpoint at /metrics.
#
# The TOKEN IS REQUIRED outside development when metrics are on, and config
# refuses to start without it: the endpoint describes how much business every
# shop on this stack is doing. Nginx also answers /metrics with 404 from
# outside, so a scraper reaches it over the internal network only.
#   openssl rand -hex 32
RAWSYST_METRICS_ENABLED=true
RAWSYST_METRICS_TOKEN=CHANGE_ME

# Error reporting. Empty means off, which is the default — most shops run one
# server and read the logs.
#
# What is sent is bounded on this side rather than in Sentry's settings: a 5xx
# or a panic, with the request id, the route PATTERN, the method, the status
# and the tenant uuid. No query string, no headers, no body, no email, no IP.
RAWSYST_SENTRY_DSN=
# The fraction of performance TRACES sampled, 0 to 1. Errors are always sent.
RAWSYST_SENTRY_SAMPLE_RATE=0.1

# --- the optional profiles --------------------------------------------------
#
#   docker compose --profile scale up    redis + nginx
#   docker compose --profile files up    + object storage
#   docker compose --profile watch up    + prometheus

# Where nginx reads its certificate. A real deployment points this at whatever
# its ACME client writes.
TLS_CERT_DIR=./deploy/nginx/certs
HTTP_PORT=80
HTTPS_PORT=443

# The cache ceiling. Redis without one grows until the kernel kills it, and
# what it takes down is the machine the database is on.
REDIS_MAXMEMORY=256mb

MINIO_CONSOLE_PORT=9001

# Names this deployment in the metrics, so two shops' figures cannot be
# confused when they reach the same dashboard.
DEPLOYMENT_NAME=rawsyst
PROMETHEUS_RETENTION=30d
