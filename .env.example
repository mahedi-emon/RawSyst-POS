# RawSyst POS — deployment environment.
#
#   cp .env.example .env   and fill in every value marked CHANGE_ME.
#
# .env is gitignored and is in .dockerignore: a credential copied into an image
# is readable by anyone who can pull it, and `docker history` shows it even
# after a later layer deletes the file.

# --- the database -----------------------------------------------------------
POSTGRES_DB=rawsyst
POSTGRES_USER=rawsyst
# openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# --- the application --------------------------------------------------------
RAWSYST_ENV=production

# Which region THIS stack serves. Blueprint E4.2 requires per-tenant data
# residency; a deployment serves one.
RAWSYST_DATA_REGION=sa

# Token signing. At least 32 bytes.
#   openssl rand -base64 48
RAWSYST_JWT_SECRET=CHANGE_ME
RAWSYST_JWT_ISSUER=rawsyst-pos

# Envelope encryption for credentials at rest, newest key first.
#
# The version is written explicitly rather than implied by position, and that
# matters: an implicit scheme where the current key is always v1 survives
# exactly one rotation, and on the second a fresh "v1" collides with the
# original — unreadable credentials with no way back.
#
#   printf '1:%s' "$(openssl rand -base64 32)"
RAWSYST_DATA_ENCRYPTION_KEYS=CHANGE_ME

# Browser origins allowed to call the API. Empty means none, which is correct
# for a deployment serving only the Tauri till. The back office needs its own
# origin listed here.
#   RAWSYST_CORS_ORIGINS=https://office.example.com
RAWSYST_CORS_ORIGINS=

# The shop's local day. The accounting date and every Z report follow it, so
# this is a business setting rather than a preference.
TZ=Asia/Riyadh

# --- where things listen ----------------------------------------------------
API_PORT=8080
WEB_PORT=3000

# --- connection pool --------------------------------------------------------
# Sized against the database's own max_connections, not against traffic. Every
# API replica takes this many.
RAWSYST_DB_MAX_CONNS=20
RAWSYST_DB_MIN_CONNS=2

# Stamped into the image tag and reported by the binaries.
VERSION=dev
