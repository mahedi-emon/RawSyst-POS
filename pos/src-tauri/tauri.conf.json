{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RawSyst POS",
  "version": "0.1.0",
  "identifier": "sa.rawsyst.pos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "RawSyst POS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8080 https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "RawSyst",
    "copyright": "Copyright © 2026 RawSyst",
    "category": "Business",
    "shortDescription": "Retail point of sale and back office",
    "longDescription": "RawSyst POS is an offline-first point of sale for retail shops, with stock, accounting and VAT built in rather than bolted on.",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}
