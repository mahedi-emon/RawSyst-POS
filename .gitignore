# Tauri POS
pos/node_modules/
pos/dist/
pos/src-tauri/target/

# Regenerated by the Tauri build from tauri.conf.json and the capability files,
# so committing them only produces churn on every plugin or version bump.
pos/src-tauri/gen/schemas/

# TypeScript incremental build cache. Machine-local, rewritten by every
# build, and was tracked by accident — it turned up as a change in every
# commit that happened to run one.
*.tsbuildinfo
zatca-docs/

# Screenshots the visual pass writes. Output of a check, not source.
/.shots/
/shots/
