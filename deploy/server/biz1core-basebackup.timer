[Unit]
Description=Biz1core physical base backup, weekly
Documentation=file:/opt/biz1core/deploy/server/PITR.md

[Timer]
# Sunday at 02:00, ninety minutes before the nightly dump so the two never
# contend for the disk, and on the quietest night of the week in both markets.
#
# Weekly, not nightly. See the service file: a seven-day recovery window needs
# ONE base backup older than the window plus the log since it, and a second copy
# of the whole cluster every night would cost seven times the storage to shorten
# a replay nobody is waiting on.
#
# Raising the frequency shortens recovery TIME, not the recovery POINT. If a
# recovery on this server turns out to take hours of replay, move this to twice
# a week before touching anything else — and raise RAWSYST_PITR_MAX_BASE_BACKUPS
# with it, or retention will simply throw the extras away.
OnCalendar=Sun *-*-* 02:00:00

RandomizedDelaySec=20min

# A machine that was off on Sunday takes one when it comes back, rather than
# skipping a week and nobody noticing until the week it mattered.
Persistent=true

[Install]
WantedBy=timers.target
