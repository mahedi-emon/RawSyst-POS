[Unit]
# The whole recovery, end to end, against disposable resources.
#
# # Why this exists when the nightly backup already verifies
#
# The nightly `verify` proves the DUMP restores. It does not prove that
# recovery works, because it never leaves the machine: it reads the object it
# just wrote, from a store it is already authenticated to, on a server that has
# the tools and the credentials and the directory layout already.
#
# The drill does the other half. It downloads the snapshot to files, checks
# those files against nothing but their own checksums, restores them into a
# temporary database and compares every table, every business and every policy
# against the manifest. That is the path a real recovery takes, and the failures
# it finds are the ones a verification cannot: a bucket that lists but will not
# GET, credentials with write and no read, a disk with no room for the
# downloaded copy, a manifest this build can no longer parse.
#
# # It cannot touch production
#
# It creates a temporary database, restores into that, and drops it. The live
# database is never opened for writing. That is a property of the command and
# not of this unit — see `biz1core backup rehearse`.
#
# # Weekly, not nightly
#
# It costs roughly twice a verification: a download and a restore on top of a
# dump. On two cores that is worth paying once a week and not once a night, and
# the failures it catches are configuration failures, which do not appear
# overnight.
Description=Biz1core disaster recovery drill
Documentation=file:/opt/biz1core/deploy/server/RECOVERY.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/biz1core

# Longer than the backup unit: this one takes a backup, downloads it again and
# restores it. Still bounded — a drill that hangs is a drill nobody hears about.
TimeoutStartSec=90min

# The till has first claim on the cores, as it does for the nightly backup.
Nice=15
IOSchedulingClass=idle

Environment=COMPOSE=-f docker-compose.yml -f docker-compose.server.yml --profile backup

# The report goes to the journal. `journalctl -u biz1core-drill -n 50` is what
# an operator reads the morning after, and what they should be able to show
# somebody who asks whether this business could be brought back.
ExecStart=/usr/bin/docker compose $COMPOSE run --rm backup rehearse
